# ── Secrets ─────────────────────────────────────────
.env
.env.*
!env.example

# ── Dependencies (run `composer install --no-dev` on the server) ──
/vendor/
node_modules/

# ── Backups / old copies ────────────────────────────
# date-suffixed copies, e.g. Routes.php13-5-26, main.css17-4-26-01
*.php[0-9]*
*.css[0-9]*
*.js[0-9]*
.htaccess[0-9]*
*-bk
*bk
*_bk*
*_bak*
*.bak
*-old
*_old
*.orig
*copy*
*(1)*
*backup*
/assets/images/_bk_*/

# ── Archives ────────────────────────────────────────
*.zip
*.rar
*.7z
*.tar
*.gz

# ── Logs, cache, temp (keep folder skeletons) ───────
*.log
error_log
/writable/cache/*
/writable/logs/*
/writable/session/*
/writable/debugbar/*
/writable/uploads/*
!/writable/**/.gitkeep
/cache/
/tmp/

# ── OS / IDE ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# ── Database dump (wanted in repo) ─────────────────
!/database/
!/database/**
